# Use your public DNS name in production. Caddy will then obtain and renew its
# certificate automatically. Use http://localhost for local HTTP testing.
JATRAIL_SITE_ADDRESS=jatrail.example.com

# Must remain above FastAPI's effective request-body ceiling. The default
# FastAPI 50 MiB upload limit needs about 68 MiB including request overhead.
JATRAIL_MAX_REQUEST_BODY=150MB
