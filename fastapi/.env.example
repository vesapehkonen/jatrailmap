JATRAIL_MONGODB_URI=mongodb://localhost:27017
JATRAIL_MONGODB_DATABASE=jatrail
JATRAIL_SESSION_MAX_AGE_SECONDS=86400
# Keep true outside local HTTP development.
JATRAIL_SECURE_COOKIES=false
JATRAIL_ALLOWED_HOSTS=localhost,127.0.0.1,*
JATRAIL_MAX_ACCOUNT_STORAGE_BYTES=104857600
JATRAIL_MAX_IMAGE_BYTES=2097152
JATRAIL_MAX_PHOTOS_PER_TRAIL=100
JATRAIL_MAX_UPLOAD_BYTES=52428800
