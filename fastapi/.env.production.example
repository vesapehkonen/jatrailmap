# Copy to a file outside version control and replace every example value.
JATRAIL_MONGODB_URI=mongodb://mongo.example.internal:27017/?authSource=jatrail
JATRAIL_MONGODB_DATABASE=jatrail
# Docker secrets can supply credentials without placing them in this file.
JATRAIL_MONGODB_USERNAME_FILE=/run/secrets/mongo_app_username
JATRAIL_MONGODB_PASSWORD_FILE=/run/secrets/mongo_app_password
JATRAIL_SESSION_MAX_AGE_SECONDS=86400
JATRAIL_SECURE_COOKIES=true
JATRAIL_ALLOWED_HOSTS=jatrail.example.com
JATRAIL_MAX_ACCOUNT_STORAGE_BYTES=104857600
JATRAIL_MAX_IMAGE_BYTES=2097152
JATRAIL_MAX_PHOTOS_PER_TRAIL=30
JATRAIL_MAX_UPLOAD_BYTES=52428800
