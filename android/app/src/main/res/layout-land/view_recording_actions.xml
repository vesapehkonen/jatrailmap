<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:onClick="onClick"
            android:text="@string/start_recording"
            android:textAppearance="?attr/textAppearanceButton"
            app:icon="@drawable/ic_start_recording"
            app:iconTint="?attr/colorOnPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_stop"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:onClick="onClick"
            android:text="@string/stop_tracking_button"
            android:textAppearance="?attr/textAppearanceButton"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:icon="@drawable/ic_stop_recording"
            app:iconTint="?attr/colorError"
            app:strokeColor="?attr/colorError" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_finish"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:onClick="onClick"
            android:text="@string/finish_trail_short"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_send"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:onClick="onClick"
            android:text="@string/upload_short"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_picture"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/take_photo_short"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:onClick="onClick"
            android:padding="0dp"
            android:tooltipText="@string/take_photo_short"
            android:visibility="gone"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/delete_short"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:onClick="onClick"
            android:padding="0dp"
            android:tooltipText="@string/delete_short"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorError"
            app:strokeColor="?attr/colorError" />
    </LinearLayout>
</LinearLayout>
