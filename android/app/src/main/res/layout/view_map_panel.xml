<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="220dp">

    <org.mapsforge.map.android.view.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/map_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="40dp"
        android:background="?attr/colorSurface"
        android:elevation="3dp"
        android:maxWidth="280dp"
        android:padding="12dp"
        android:text="@string/map_not_selected"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBody2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_select_map"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:backgroundTint="?attr/colorSurface"
        android:contentDescription="@string/manage_offline_maps"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="48dp"
        android:padding="0dp"
        android:tooltipText="@string/manage_offline_maps"
        app:icon="@drawable/ic_offline_map"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/text_gps_status"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="@string/gps_inactive"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_recenter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="?attr/colorSurface"
            android:contentDescription="@string/recenter_map"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:padding="0dp"
            android:tooltipText="@string/recenter_map"
            app:icon="@drawable/ic_my_location"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"
            app:strokeColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_zoom_in"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="?attr/colorSurface"
            android:contentDescription="@string/zoom_in"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:padding="0dp"
            android:tooltipText="@string/zoom_in"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"
            app:strokeColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_zoom_out"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="?attr/colorSurface"
            android:contentDescription="@string/zoom_out"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:padding="0dp"
            android:tooltipText="@string/zoom_out"
            app:icon="@drawable/ic_remove"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"
            app:strokeColor="?attr/colorPrimary" />
    </LinearLayout>
</FrameLayout>
